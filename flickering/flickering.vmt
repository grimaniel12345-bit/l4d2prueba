UnlitGeneric
{
    "$basetexture" "flickering/flickering"
    "$translucent" "1"
    "$vertexcolor" "1"
    "$vertexalpha" "1"
    "$no_fullbright" "1"
    "$ignorez" "1"
    "$alpha" "0.10"  // 10% de opacidad 

    Proxies
    {
        AnimatedTexture
        {
            animatedTextureVar "$basetexture"
            animatedTextureFrameNumVar "$frame"
            animatedTextureFrameRate "17"  // Ajustar según la velocidad de la animación
        }
        ConVar
        {
            convar "flickering_frame"
            resultVar "$frame"
        }
    }
}